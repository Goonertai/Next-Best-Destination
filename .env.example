# Public URL for the web app to reach the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional server-side key for Google Places API (New) and Routes API.
# Keep this value in apps/api's environment; never expose it to the browser.
GOOGLE_MAPS_API_KEY=
# Optional server-side key for natural-language itinerary edits with the Agents SDK.
OPENAI_API_KEY=
# Optional database URL. If unset, local development stores saved trips in SQLite.
# For PostgreSQL, use postgresql://user:password@localhost:5432/travel_agent
DATABASE_URL=
